{%- comment -%}
  Panier latéral : mis à jour sans recharger la page (Ajax Cart API + Section Rendering API,
  section « cart-drawer »). Le paiement se fait sur le checkout natif Shopify.
{%- endcomment -%}
<div class="cart-drawer" id="CartDrawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-labelledby="CartDrawer-Title" tabindex="-1">
    <div id="CartDrawer-Contents" data-cart-contents data-cart-root data-section-id="cart-drawer">
      {% render 'cart-drawer-contents' %}
    </div>
  </div>
</div>
