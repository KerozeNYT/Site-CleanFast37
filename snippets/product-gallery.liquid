{%- comment -%}
  Galerie produit : visuel principal immédiatement visible, défilement au doigt, miniatures,
  agrandissement (zoom) en plein écran. Médias gérés dans la fiche produit Shopify.
  Paramètres : product, gallery_id, sizes
{%- endcomment -%}
{%- liquid
  assign gid = gallery_id | default: 'gallery'
  assign img_sizes = sizes | default: '(min-width: 990px) 640px, 100vw'
  assign total = product.media.size
-%}
<div class="gallery" data-gallery id="{{ gid }}">
  {%- if total == 0 -%}
    <div class="media gallery__item gallery__item--empty">
      {% render 'media-placeholder', label: 'photos HD du rouleau ACE2ACE (fermé 3/4, ouvert, compartiment, poignée, en situation)', kind: 'product-1' %}
    </div>
  {%- else -%}
    <ul class="gallery__track" role="list" data-gallery-track aria-label="{{ 'product.gallery' | t }}">
      {%- for media in product.media -%}
        <li class="gallery__item" data-index="{{ forloop.index0 }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <button type="button" class="gallery__zoom" data-zoom="{{ forloop.index0 }}" aria-label="{{ 'product.zoom' | t: index: forloop.index }}">
                {%- if forloop.first -%}
                  {% render 'responsive-image', image: media.preview_image, eager: true, sizes: img_sizes, widths: '550, 750, 1100, 1500, 2000', alt: media.alt %}
                {%- else -%}
                  {% render 'responsive-image', image: media.preview_image, sizes: img_sizes, widths: '550, 750, 1100, 1500, 2000', alt: media.alt %}
                {%- endif -%}
              </button>
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, muted: true, playsinline: true, preload: 'none', image_size: '1100x' }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: loading: 'lazy' }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if total > 1 -%}
      <div class="gallery__nav">
        <button type="button" class="icon-button" data-gallery-prev aria-label="{{ 'product.previous_media' | t }}">{% render 'icon', name: 'chevron-left' %}</button>
        <span class="small" data-gallery-counter aria-live="polite">{{ 'product.media_counter' | t: index: 1, total: total }}</span>
        <button type="button" class="icon-button" data-gallery-next aria-label="{{ 'product.next_media' | t }}">{% render 'icon', name: 'chevron-right' %}</button>
      </div>
      <ul class="gallery__thumbs" role="list">
        {%- for media in product.media -%}
          <li>
            <button type="button" data-gallery-thumb="{{ forloop.index0 }}" aria-label="{{ 'product.media_counter' | t: index: forloop.index, total: total }}"{% if forloop.first %} aria-current="true"{% endif %}>
              {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '', width: 72, height: 72 }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <dialog class="zoom-dialog" data-zoom-dialog aria-label="{{ 'product.gallery' | t }}">
      <button type="button" class="icon-button zoom-dialog__close" data-zoom-close aria-label="{{ 'product.close_zoom' | t }}">{% render 'icon', name: 'close' %}</button>
      <div class="zoom-dialog__track">
        {%- for media in product.media -%}
          {%- if media.media_type == 'image' -%}
            <figure data-zoom-index="{{ forloop.index0 }}">
              {{ media.preview_image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '1100, 1600, 2400', sizes: '100vw', alt: media.alt }}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </dialog>
  {%- endif -%}
</div>
