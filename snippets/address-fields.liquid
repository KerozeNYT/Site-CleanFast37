{%- comment -%} Champs d'adresse client. Paramètres : form, prefix {%- endcomment -%}
<div class="stack address-fields">
  <div class="contact__row">
    <div class="field"><label for="AddressFirstName-{{ prefix }}">{{ 'customer.first_name' | t }}</label><input id="AddressFirstName-{{ prefix }}" type="text" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
    <div class="field"><label for="AddressLastName-{{ prefix }}">{{ 'customer.last_name' | t }}</label><input id="AddressLastName-{{ prefix }}" type="text" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
  </div>
  <div class="field"><label for="AddressCompany-{{ prefix }}">{{ 'customer.company' | t }}</label><input id="AddressCompany-{{ prefix }}" type="text" name="address[company]" value="{{ form.company }}" autocomplete="organization"></div>
  <div class="field"><label for="AddressAddress1-{{ prefix }}">{{ 'customer.address1' | t }}</label><input id="AddressAddress1-{{ prefix }}" type="text" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
  <div class="field"><label for="AddressAddress2-{{ prefix }}">{{ 'customer.address2' | t }}</label><input id="AddressAddress2-{{ prefix }}" type="text" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
  <div class="contact__row">
    <div class="field"><label for="AddressZip-{{ prefix }}">{{ 'customer.zip' | t }}</label><input id="AddressZip-{{ prefix }}" type="text" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
    <div class="field"><label for="AddressCity-{{ prefix }}">{{ 'customer.city' | t }}</label><input id="AddressCity-{{ prefix }}" type="text" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
  </div>
  <div class="field">
    <label for="AddressCountry-{{ prefix }}">{{ 'customer.country' | t }}</label>
    <select id="AddressCountry-{{ prefix }}" name="address[country]" autocomplete="country">{{ all_country_option_tags }}</select>
  </div>
  <div class="field"><label for="AddressPhone-{{ prefix }}">{{ 'customer.phone' | t }}</label><input id="AddressPhone-{{ prefix }}" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
  <label class="small"><input type="checkbox" name="address[default]" value="1"{% if form.set_as_default_checkbox %} checked{% endif %}> {{ 'customer.set_default' | t }}</label>
  <div><button type="submit" class="button">{{ 'customer.save' | t }}</button></div>
</div>
