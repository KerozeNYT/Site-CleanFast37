<section class="page-content account">
  <div class="account__narrow stack">
    <h1>{{ 'customer.register' | t }}</h1>
    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field">
        <label for="RegisterFirstName">{{ 'customer.first_name' | t }}</label>
        <input id="RegisterFirstName" type="text" name="customer[first_name]" autocomplete="given-name">
      </div>
      <div class="field">
        <label for="RegisterLastName">{{ 'customer.last_name' | t }}</label>
        <input id="RegisterLastName" type="text" name="customer[last_name]" autocomplete="family-name">
      </div>
      <div class="field">
        <label for="RegisterEmail">{{ 'customer.email' | t }}</label>
        <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" autocapitalize="off" required>
      </div>
      <div class="field">
        <label for="RegisterPassword">{{ 'customer.password' | t }}</label>
        <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--full">{{ 'customer.register' | t }}</button>
    {%- endform -%}
    <a class="link-chevron" href="{{ routes.account_login_url }}">{{ 'customer.login' | t }}</a>
  </div>
</section>

{% schema %}
{ "name": "Création de compte", "tag": "div", "settings": [] }
{% endschema %}
