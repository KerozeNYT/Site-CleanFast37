<article class="page-content">
  <div class="text-width stack">
    <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
      <ol>
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        <li><a href="{{ blog.url }}">{{ blog.title }}</a></li>
        <li aria-current="page">{{ article.title }}</li>
      </ol>
    </nav>
    <h1>{{ article.title }}</h1>
    <p class="small">{{ article.published_at | time_tag: format: 'date' }}</p>
    {%- if article.image != blank -%}
      <div class="media article__media">
        {% render 'responsive-image', image: article.image, sizes: '(min-width: 990px) 980px, 92vw', eager: true %}
      </div>
    {%- endif -%}
    <div class="rte">{{ article.content }}</div>
  </div>
</article>

{% schema %}
{ "name": "Article", "tag": "div", "settings": [] }
{% endschema %}
