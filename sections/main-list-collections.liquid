<section class="page-content">
  <div class="page-width stack">
    <h1>{{ 'templates.collections_title' | t }}</h1>
    <ul class="product-grid" role="list">
      {%- for collection in collections -%}
        <li>
          <a class="product-card__link" href="{{ collection.url }}">
            <div class="media product-card__media">
              {%- if collection.featured_image != blank -%}
                {% render 'responsive-image', image: collection.featured_image, sizes: '(min-width: 990px) 400px, 50vw', widths: '300, 400, 600, 800' %}
              {%- else -%}
                {% render 'media-placeholder', kind: 'collection-1' %}
              {%- endif -%}
            </div>
            <h2 class="product-card__title">{{ collection.title }}</h2>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Liste des collections", "tag": "div", "settings": [] }
{% endschema %}
