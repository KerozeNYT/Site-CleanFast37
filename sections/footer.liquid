{%- comment -%} Pied de page : marque, menus, mention sur la marque ACE2ACE, paiements, réseaux. {%- endcomment -%}
<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__grid">
      <div class="site-footer__brand stack">
        <h2>{{ section.settings.heading | default: shop.name }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if settings.brand_notice != blank -%}<div class="rte">{{ settings.brand_notice }}</div>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        {%- if block.settings.menu != blank -%}
          <div {{ block.shopify_attributes }}>
            <h2>{{ block.settings.menu.title }}</h2>
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="site-footer__bottom">
      {%- assign current_year = 'now' | date: '%Y' -%}
      <span>{{ 'footer.copyright' | t: year: current_year, shop: shop.name }}</span>
      <button type="button" class="footer-link" data-cookie-preferences hidden>{{ 'footer.cookie_preferences' | t }}</button>
      {%- liquid
        assign socials = ''
        if settings.social_tiktok != blank
          assign socials = socials | append: 'tiktok,'
        endif
        if settings.social_instagram != blank
          assign socials = socials | append: 'instagram,'
        endif
        if settings.social_facebook != blank
          assign socials = socials | append: 'facebook,'
        endif
        if settings.social_youtube != blank
          assign socials = socials | append: 'youtube,'
        endif
        assign social_list = socials | split: ','
      -%}
      {%- if social_list.size > 0 -%}
        <ul class="social-links" aria-label="{{ 'footer.social' | t }}">
          {%- for s in social_list -%}
            {%- assign key = 'social_' | append: s -%}
            <li><a href="{{ settings[key] }}" rel="noopener" target="_blank" aria-label="{{ s | capitalize }}">{% render 'icon', name: s %}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="payment-icons" aria-label="{{ 'footer.payment' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Pied de page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Maison Nette" },
    { "type": "richtext", "id": "text", "label": "Texte", "default": "<p>Boutique indépendante d’accessoires d’entretien pour les intérieurs partagés avec des animaux.</p>" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Afficher les moyens de paiement activés", "default": true }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "limit": 4,
      "settings": [ { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" } ]
    }
  ]
}
{% endschema %}
