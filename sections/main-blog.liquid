<section class="page-content">
  <div class="page-width stack">
    <h1>{{ blog.title }}</h1>
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="article-grid" role="list">
          {%- for article in blog.articles -%}
            <li>
              <a class="article-card" href="{{ article.url }}">
                {%- if article.image != blank -%}
                  <div class="media article-card__media">
                    {% render 'responsive-image', image: article.image, sizes: '(min-width: 990px) 400px, 92vw', widths: '400, 600, 800' %}
                  </div>
                {%- endif -%}
                <p class="small">{{ article.published_at | time_tag: format: 'date' }}</p>
                <h2 class="h3">{{ article.title }}</h2>
                <p class="small">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p>{{ 'templates.blog_empty' | t }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "tag": "div", "settings": [] }
{% endschema %}
