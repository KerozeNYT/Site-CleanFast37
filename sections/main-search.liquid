<section class="page-content">
  <div class="page-width stack">
    <h1>{{ 'general.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <div class="field">
        <label class="visually-hidden" for="SearchInput">{{ 'general.search_placeholder' | t }}</label>
        <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search_placeholder' | t }}">
      </div>
      <button type="submit" class="button">{{ 'general.search' | t }}</button>
    </form>
    {%- if search.performed -%}
      <p class="small">{{ 'general.search_results' | t: terms: search.terms }}</p>
      {%- paginate search.results by 12 -%}
        {%- if search.results_count > 0 -%}
          <ul class="product-grid" role="list">
            {%- for item in search.results -%}
              <li>
                {%- if item.object_type == 'product' -%}
                  {% render 'product-card', product: item %}
                {%- else -%}
                  <a class="search-result" href="{{ item.url }}">
                    <h2 class="h3">{{ item.title }}</h2>
                    <p class="small">{{ item.content | strip_html | truncatewords: 24 }}</p>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}
          <p>{{ 'general.search_empty' | t }}</p>
        {%- endif -%}
        {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Recherche", "tag": "div", "settings": [] }
{% endschema %}
