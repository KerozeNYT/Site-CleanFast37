{%- comment -%} Boutique en préparation : message, inscription facultative, accès propriétaire. {%- endcomment -%}
<section class="password center">
  <div class="text-width stack">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1 class="h1">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}

    {%- if section.settings.show_signup -%}
      {%- form 'customer', id: 'PasswordSignup', class: 'password__signup' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-message" role="status">{{ 'templates.password_signup_success' | t }}</p>
        {%- else -%}
          <div class="field">
            <label for="PasswordSignupEmail">{{ 'customer.email' | t }}</label>
            <input id="PasswordSignupEmail" type="email" name="contact[email]" autocomplete="email" required>
          </div>
          <p class="small">{{ section.settings.consent }}</p>
          <button type="submit" class="button">{{ 'templates.password_signup' | t }}</button>
        {%- endif -%}
      {%- endform -%}
    {%- endif -%}

    <details class="password__owner">
      <summary class="small">{{ 'templates.password_owner' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field">
          <label for="StorefrontPassword">{{ 'templates.password_label' | t }}</label>
          <input id="StorefrontPassword" type="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="button button--dark">{{ 'templates.password_enter' | t }}</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Page mot de passe",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ouverture prochaine." },
    { "type": "checkbox", "id": "show_signup", "label": "Inscription pour être prévenu", "default": false },
    { "type": "text", "id": "consent", "label": "Mention de consentement", "default": "En vous inscrivant, vous acceptez de recevoir nos e-mails. Désinscription possible à tout moment." }
  ]
}
{% endschema %}
