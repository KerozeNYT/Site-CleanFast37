<section class="page-content account">
  <div class="account__narrow stack">
    <h1>{{ 'customer.reset' | t }}</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="ResetPassword">{{ 'customer.password' | t }}</label><input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="ResetPasswordConfirm">{{ 'customer.password_confirm' | t }}</label><input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button type="submit" class="button">{{ 'customer.reset' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Nouveau mot de passe", "tag": "div", "settings": [] }
{% endschema %}
