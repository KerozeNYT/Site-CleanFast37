<section class="page-content account">
  <div class="page-width stack">
    <div class="account__head">
      <h1>{{ 'customer.account' | t }}</h1>
      <a class="link-chevron" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a>
    </div>
    <div class="account__grid">
      <div class="stack">
        <h2 class="h3">{{ 'customer.orders' | t }}</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="table">
              <thead>
                <tr><th scope="col">{{ 'customer.order_number' | t }}</th><th scope="col">{{ 'customer.date' | t }}</th><th scope="col">{{ 'customer.status' | t }}</th><th scope="col">{{ 'customer.total' | t }}</th></tr>
              </thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p>{{ 'customer.no_orders' | t }}</p>
          {%- endif -%}
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      </div>
      <div class="stack">
        <h2 class="h3">{{ 'customer.details' | t }}</h2>
        <p>{{ customer.name }}<br>{{ customer.email }}</p>
        {%- if customer.default_address -%}
          <address class="small">{{ customer.default_address | format_address }}</address>
        {%- endif -%}
        <a class="link-chevron" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Compte client", "tag": "div", "settings": [] }
{% endschema %}
