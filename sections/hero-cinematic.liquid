{%- comment -%}
  Hero cinématique. Médias administrables : image et vidéo pour ordinateur, image et vidéo
  verticales pour téléphone. La vidéo ne démarre que si elle est visible, sans son, et jamais
  quand le visiteur demande moins d'animations ou économise ses données : l'image fixe
  s'affiche alors immédiatement. Sans média, la vraie photo du produit est mise en avant.
{%- endcomment -%}
{{ 'section-hero.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.product
  if p == blank
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant
  assign has_media = false
  if section.settings.image != blank or section.settings.video != blank
    assign has_media = true
  endif
  assign main_link = section.settings.button_link | default: p.url
  assign poster = section.settings.image | default: section.settings.video.preview_image
  assign poster_mobile = section.settings.image_mobile | default: section.settings.video_mobile.preview_image | default: poster
-%}
<section class="hero{% if has_media %} hero--media hero--{{ section.settings.text_color }}{% else %} hero--product{% endif %}" aria-labelledby="Hero-{{ section.id }}">
  {%- if has_media -%}
    <div class="hero__media" data-hero-media>
      {%- if poster != blank -%}
        <picture>
          {%- if poster_mobile != blank and poster_mobile != poster -%}
            <source media="(max-width: 749px)" srcset="{{ poster_mobile | image_url: width: 750 }} 750w, {{ poster_mobile | image_url: width: 1100 }} 1100w, {{ poster_mobile | image_url: width: 1500 }} 1500w" sizes="100vw">
          {%- endif -%}
          {{ poster | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1880, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image_alt, class: 'hero__poster' }}
        </picture>
      {%- endif -%}
      {%- if section.settings.video != blank -%}
        {%- capture src_desktop -%}{% render 'video-sources', video: section.settings.video %}{%- endcapture -%}
        {%- capture src_mobile -%}{% if section.settings.video_mobile != blank %}{% render 'video-sources', video: section.settings.video_mobile, max_height: 1920 %}{% endif %}{%- endcapture -%}
        <video
          class="hero__video"
          muted
          playsinline
          loop
          preload="none"
          aria-hidden="true"
          data-hero-video
          data-src="{{ src_desktop | strip }}"
          {% if src_mobile != blank %}data-src-mobile="{{ src_mobile | strip }}"{% endif %}
        ></video>
        <button type="button" class="hero__toggle" data-hero-toggle hidden aria-label="{{ 'general.pause_video' | t }}">
          <span data-icon-pause>{% render 'icon', name: 'pause' %}</span>
          <span data-icon-play hidden>{% render 'icon', name: 'play' %}</span>
        </button>
      {%- endif -%}
      {%- if section.settings.illustrative -%}<span class="media-badge">{{ 'general.illustrative' | t }}</span>{%- endif -%}
      <div class="hero__shade" style="--shade: {{ section.settings.overlay | divided_by: 100.0 }}"></div>
    </div>
  {%- endif -%}

  <div class="hero__content text-width center" data-hero-content>
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="h-hero" id="Hero-{{ section.id }}">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="lead hero__lead">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if p != blank and section.settings.show_price -%}
      <p class="hero__price"><span>{{ p.vendor }}</span> — <strong>{{ v.price | money }}</strong> {{ 'general.price_ttc' | t }}</p>
    {%- endif -%}
    <div class="actions">
      {%- if section.settings.button_label != blank -%}
        <a class="button{% if has_media and section.settings.text_color == 'light' %} button--light{% endif %}" href="{{ main_link }}">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="link-chevron" href="{{ section.settings.secondary_link | default: '#demonstration' }}">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- unless has_media -%}
    <div class="hero__product page-width">
      <div class="media hero__product-media">
        {%- if p.featured_media != blank -%}
          {% render 'responsive-image', image: p.featured_media.preview_image, eager: true, sizes: '(min-width: 1280px) 1100px, 92vw', class: 'hero__product-img' %}
        {%- else -%}
          {% render 'media-placeholder', label: 'vidéo du hero (8–12 s) ou photo du rouleau ACE2ACE dans un salon', kind: 'lifestyle-1' %}
        {%- endif -%}
      </div>
    </div>
  {%- endunless -%}
</section>

{% schema %}
{
  "name": "Hero cinématique",
  "tag": "div",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Textes" },
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "ACE2ACE · Rouleau anti-poils réutilisable" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "On les adore. Leurs poils, un peu moins." },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Découvrez une façon simple de retirer les poils de vos compagnons sur vos textiles du quotidien." },
    { "type": "product", "id": "product", "label": "Produit" },
    { "type": "checkbox", "id": "show_price", "label": "Afficher la marque et le prix", "default": true },
    { "type": "text", "id": "button_label", "label": "Bouton principal", "default": "Découvrir le rouleau" },
    { "type": "url", "id": "button_link", "label": "Lien du bouton principal", "info": "Vide : fiche produit." },
    { "type": "text", "id": "secondary_label", "label": "Lien secondaire", "default": "Voir la démonstration" },
    { "type": "text", "id": "secondary_link", "label": "Ancre du lien secondaire", "default": "#demonstration" },
    { "type": "header", "content": "Médias", "info": "Image fixe affichée immédiatement (connexion lente, animations désactivées) ; vidéo lancée seulement si elle est visible." },
    { "type": "image_picker", "id": "image", "label": "Image (ordinateur)", "info": "2400 × 1350 px conseillé. Salon lumineux, canapé en tissu, rouleau ACE2ACE réel." },
    { "type": "text", "id": "image_alt", "label": "Texte alternatif de l’image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image verticale (téléphone)", "info": "1080 × 1920 px conseillé." },
    { "type": "video", "id": "video", "label": "Vidéo (ordinateur)", "info": "8 à 12 s, sans son, MP4 compressé." },
    { "type": "video", "id": "video_mobile", "label": "Vidéo verticale (téléphone)", "info": "Format 9:16." },
    { "type": "checkbox", "id": "illustrative", "label": "Afficher la mention « Illustration »", "default": true, "info": "À cocher pour une vidéo ou image générée : elle illustre, elle ne prouve pas un résultat." },
    { "type": "header", "content": "Lisibilité" },
    { "type": "select", "id": "text_color", "label": "Texte sur le média", "default": "light", "options": [ { "value": "light", "label": "Clair" }, { "value": "dark", "label": "Foncé" } ] },
    { "type": "range", "id": "overlay", "label": "Voile sur le média", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 30 }
  ],
  "presets": [ { "name": "Hero cinématique" } ]
}
{% endschema %}
