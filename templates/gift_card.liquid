{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
    {% render 'theme-styles' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="page-content center" id="MainContent">
      <div class="text-width stack">
        <p class="eyebrow">{{ shop.name }}</p>
        <h1>{{ 'gift_card.title' | t }}</h1>
        {%- if gift_card.expired or gift_card.enabled == false -%}
          <p class="form-message form-message--error">{{ 'gift_card.expired' | t }}</p>
        {%- endif -%}
        <p class="h2">{{ gift_card.initial_value | money }}</p>
        {%- if gift_card.balance != gift_card.initial_value -%}
          {%- assign balance = gift_card.balance | money -%}
          <p>{{ 'gift_card.balance' | t: balance: balance }}</p>
        {%- endif -%}
        <p class="small">{{ 'gift_card.code' | t }}</p>
        <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
        <div class="actions">
          <a class="button" href="{{ shop.url }}">{{ 'gift_card.use' | t }}</a>
        </div>
      </div>
    </main>
  </body>
</html>
